                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/destinasi?kota={{kota_uji}}&batas=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "destinasi"
              ],
              "query": [
                {
                  "key": "kota",
                  "value": "{{kota_uji}}",
                  "description": "Nama kabupaten/kota Sumatera Utara (misal: Samosir, Medan, Karo, Langkat)"
                },
                {
                  "key": "batas",
                  "value": "5",
                  "description": "Jumlah maksimal item per halaman (1-50)"
                }
              ]
            },
            "description": "Endpoint utama yang dibagikan ke kelompok Tur Guide, Kuliner, Penginapan, dan Transportasi untuk mengambil wisata terdekat berdasarkan kota/kabupaten."
          },
          "response": []
        },
        {
