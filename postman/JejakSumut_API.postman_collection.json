  "item": [
    {
      "name": "01 - Status Server & Kesehatan API",
      "description": "Endpoint root untuk memverifikasi server REST API Backend aktif dan terhubung ke database PostgreSQL jejaksumut_db.",
      "item": [
        {
          "name": "Cek Status Koneksi & Ringkasan Database",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status HTTP harus 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respons JSON menampilkan status sukses dan total_destinasi > 0', function () {",
                  "    const isi = pm.response.json();",
                  "    pm.expect(isi.status).to.eql('sukses');",
                  "    pm.expect(isi.ringkasan_data).to.be.an('object');",
                  "    pm.expect(isi.ringkasan_data.total_destinasi).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Memeriksa status layanan REST API JejakSumut beserta total destinasi, kabupaten/kota, dan kategori dari PostgreSQL."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - API Publik Wisata Sumut (Untuk 4 Kelompok Mitra)",
      "description": "Endpoint publik yang dapat langsung dikonsumsi oleh kelompok Penyedia Tur Guide, Kuliner/Rumah Makan, Penginapan, dan Transportasi.",
      "item": [
        {
          "name": "Daftar Katalog Destinasi (Paginasi Default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status HTTP harus 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Data katalog destinasi berbentuk array dan memiliki paginasi', function () {",
                  "    const isi = pm.response.json();",
                  "    pm.expect(isi.status).to.eql('berhasil');",
                  "    pm.expect(isi.data).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(isi.paginasi).to.be.an('object');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/destinasi",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "destinasi"
              ]
            },
            "description": "Mengambil daftar destinasi wisata Sumatera Utara dengan batas default 12 data per halaman."
          },
          "response": []
        },
        {
          "name": "Filter Destinasi per Kota/Kabupaten (Endpoint Utama Mitra)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status HTTP harus 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Destinasi terfilter sesuai kota uji', function () {",
                  "    const isi = pm.response.json();",
                  "    pm.expect(isi.status).to.eql('berhasil');",
                  "    pm.expect(isi.data).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(isi.data[0]).to.have.property('koordinat');",
                  "});"
