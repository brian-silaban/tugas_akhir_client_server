        {
          "name": "Buat Pemesanan Tiket Baru (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status HTTP harus 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Tiket berhasil dibuat dan kode JSM terbentuk', function () {",
                  "    const isi = pm.response.json();",
                  "    pm.expect(isi.status).to.eql('berhasil');",
                  "    pm.expect(isi.data).to.be.an('object');",
                  "    pm.expect(isi.data.kode_pemesanan).to.match(/^JSM-/);",
                  "    if (isi.data.id) {",
                  "        pm.collectionVariables.set('id_pemesanan', String(isi.data.id));",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
