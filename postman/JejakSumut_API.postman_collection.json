        {
          "name": "Daftar Ulasan Satu Destinasi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status HTTP harus 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respons memuat rata_rating, jumlah_ulasan, dan daftar data', function () {",
                  "    const isi = pm.response.json();",
                  "    pm.expect(isi.status).to.eql('berhasil');",
                  "    pm.expect(isi).to.have.property('rata_rating');",
                  "    pm.expect(isi).to.have.property('jumlah_ulasan');",
                  "    pm.expect(isi.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ulasan?id_destinasi={{id_destinasi}}",
